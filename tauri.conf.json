{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalPrivacyScreen",
  "version": "0.1.0",
  "identifier": "com.baidu.localprivacyscreen",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "本地隐私屏",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost data:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
